{
  "name": "keep-a-changelog-new-release-action",
  "version": "1.0.0",
  "private": true,
  "description": "A GitHub action for updating your Keep-A-Changelog CHANGELOG.md for new releases",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks",
    "build": "webpack --mode production",
    "compile": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomaseizinger/keep-a-changelog-new-release.git"
  },
  "author": "Thomas Eizinger",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "stream-buffers": "^3.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/stream-buffers": "^3.0.8",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.2",
    "js-yaml": "^5.4.2",
    "mock-env": "^0.2.0",
    "prettier": "^3.9.9",
    "to-vfile": "^8.0.0",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "yarn-upgrade-all": "^0.8.1"
  }
}
